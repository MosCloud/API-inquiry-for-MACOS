# DMG window geometry, in logical points. Read by two places so the arrow,
# the card and Finder's icon positions cannot drift apart again (#107):
#   - Scripts/generate-dmg-background.swift draws the background around them
#   - Scripts/package-dmg.sh tells Finder where to put the two icons
DMG_WINDOW_WIDTH="760"
DMG_WINDOW_HEIGHT="420"
DMG_WINDOW_LEFT="160"
DMG_WINDOW_TOP="160"
DMG_ICON_SIZE="152"
DMG_APP_ICON_X="210"
DMG_APP_ICON_Y="196"
DMG_FOLDER_ICON_X="550"
DMG_FOLDER_ICON_Y="196"
